{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["clear-text", "progress", "html", "json"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "lib/guard/**/*.ts",
    "lib/manager.ts",
    "lib/store/**/*.ts"
  ],
  "timeoutMS": 10000,
  "concurrency": 4
}
