{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["clear-text", "json", "html"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "lib/index.ts",
    "lib/http/index.ts"
  ],
  "timeoutMS": 300000,
  "timeoutFactor": 1.5,
  "concurrency": 4
}
