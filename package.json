{
  "name": "dsh-db-tool",
  "version": "1.5.91",
  "description": "DSH community plugin: chat-operated multi-database admin tool with sidebar management, project-scoped grants, ro/rw modes and dangerous-operation confirmation",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mengqi1436/dsh-db-tool.git"
  },
  "bugs": {
    "url": "https://github.com/mengqi1436/dsh-db-tool/issues"
  },
  "homepage": "https://github.com/mengqi1436/dsh-db-tool#readme",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0-rc.6 <0.2.0-0 || 0.1.7-rc.2 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('fs'); fs.mkdirSync('dist/script',{recursive:true}); fs.copyFileSync('lib/script/worker.cjs','dist/script/worker.cjs'); console.log('build OK')\" && node scripts/build-mongodb.mjs && node scripts/build-codemirror.mjs",
    "build:mongodb": "node scripts/build-mongodb.mjs",
    "build:codemirror": "node scripts/build-codemirror.mjs",
    "prepack": "npm run build",
    "patch:dsh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/apply-dsh-hotfix.ps1",
    "patch:dsh:sh": "bash scripts/apply-dsh-hotfix.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "bson": "^7.2.0",
    "dmdb": "^1.0.52452",
    "gaussdb-node": "^0.2.2",
    "mysql2": "^3.24.4",
    "oracledb": "^7.0.1",
    "pg": "^8.23.0",
    "redis": "^6.2.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@deepseek-ai/cordis": "^4.0.4",
    "@lezer/highlight": "^1.2.4",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "dsh-better-sidebar": "^0.24.1",
    "esbuild": "^0.28.0",
    "mongodb": "^7.6.0",
    "sql-formatter": "^15.9.0",
    "stryker-cli": "^1.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-better-sidebar": ">=0.12.0"
  },
  "files": [
    "cordis.patch.yml",
    "dist",
    "client",
    "skills",
    "docs",
    "patches",
    "scripts",
    "vendor/mongodb-driver.cjs",
    "vendor/codemirror-sql.cjs",
    "README.md",
    "README_EN.md"
  ]
}
