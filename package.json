{
  "name": "dsh-db-tool",
  "version": "0.1.0",
  "description": "DSH community plugin: chat-operated multi-database admin tool with sidebar management, project-scoped grants, ro/rw modes and dangerous-operation confirmation",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.ts",
  "exports": {
    ".": "./lib/index.ts",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:gaussdb": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-gaussdb.ps1",
    "build:gaussdb:sh": "bash scripts/build-gaussdb.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "better-sqlite3": "latest",
    "dmdb": "latest",
    "mongodb": "latest",
    "mysql2": "latest",
    "oracledb": "latest",
    "pg": "latest",
    "redis": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-better-sidebar": ">=0.12.0"
  },
  "allowScripts": {
    "oracledb@7.0.1": true
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "client",
    "skills",
    "docs",
    "scripts",
    "README.md"
  ]
}
