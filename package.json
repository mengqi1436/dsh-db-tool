{
  "name": "dsh-db-tool",
  "version": "0.1.1",
  "description": "DSH community plugin: chat-operated multi-database admin tool with sidebar management, project-scoped grants, ro/rw modes and dangerous-operation confirmation",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mengqi1436/dsh-db-tool.git"
  },
  "bugs": {
    "url": "https://github.com/mengqi1436/dsh-db-tool/issues"
  },
  "homepage": "https://github.com/mengqi1436/dsh-db-tool#readme",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0-rc.6"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('fs'); fs.mkdirSync('dist/script',{recursive:true}); fs.copyFileSync('lib/script/worker.cjs','dist/script/worker.cjs'); console.log('build OK')\"",
    "build:gaussdb": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-gaussdb.ps1",
    "build:gaussdb:sh": "bash scripts/build-gaussdb.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dmdb": "^1.0.52452",
    "mongodb": "^7.6.0",
    "mysql2": "^3.24.4",
    "oracledb": "^7.0.1",
    "pg": "^8.23.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "stryker-cli": "^1.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-better-sidebar": ">=0.12.0"
  },
  "allowScripts": {
    "oracledb@7.0.1": true
  },
  "files": [
    "cordis.patch.yml",
    "dist",
    "client",
    "skills",
    "docs",
    "scripts",
    "README.md"
  ]
}
